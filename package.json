{
  "name": "aura-67-mobile",
  "version": "0.2.5",
  "private": true,
  "description": "Aplicativo Android da plataforma Aura 67",
  "scripts": {
    "mobile:prepare": "node scripts/build-mobile.mjs && cap sync android",
    "mobile:open": "npm run mobile:prepare && cap open android",
    "mobile:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
