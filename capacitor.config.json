{
  "appId": "com.aura67.app",
  "appName": "Aura 67",
  "webDir": "www",
  "loggingBehavior": "debug",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#f4f2f7",
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#17131fff",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#f4f2f7",
      "overlaysWebView": false
    }
  }
}
